# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Snowflake ────────────────────────────────────────────────────────────────
# Account identifier: <org_name>-<account_name>  (find in Snowflake UI → Admin → Accounts)
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=SHOPSTREAM_DEV
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=dbt_dev

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=your-shopstream-bucket

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_FOLDER=/workspaces/snowflake-dbt-shopstream/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-random-secret
